{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy/ai.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/proxy/github/[...path].ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/proxy/github-raw.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/telegram/channel/[channel].ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/xtweet/profile/[handle].ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/xtweet/graphql.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
